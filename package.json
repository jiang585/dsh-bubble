{
  "name": "dsh-bubble",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 桌面悬浮球：插件宿主 + 自带 Tauri 悬浮窗子进程。",
  "type": "module",
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "web",
    "desktop/dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build:desktop": "cargo build --release --manifest-path desktop/src-tauri/Cargo.toml && node scripts/copy-desktop.mjs",
    "dev:desktop": "cargo run --manifest-path desktop/src-tauri/Cargo.toml"
  }
}
